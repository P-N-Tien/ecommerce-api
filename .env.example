NODE_ENV=development
PORT=3000

# DATABASE CONFIGURATION
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ecommerce-api-db
POSTGRES_CONTAINER_NAME=ecommerce-api-db
POSTGRES_IMAGE=postgres:18.4

# JWT CONFIGURATION

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=900 #15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=604800 #7d

# COOKIE CONFIGURATION
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_MAX_AGE_MS=604800000 # 7days

COOKIE_SAME_SITE=lax # lax, strict, or none
COOKIE_SECURE=false